{
  // The Worker for little-lens.onlyworlds.com: one hostname, no workers.dev name, no preview
  // aliases. The app answers every path, /signin/callback included.
  "name": "little-lens",
  "compatibility_date": "2026-10-26",
  "account_id": "fbc0b25eec19b417399cf4da4166f7fb",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "little-lens.onlyworlds.com",
      "custom_domain": true
    }
  ]
}
